# ── Arquivos sensíveis — NUNCA commitar ──────────────────────
config/config.php
config/database.php
.env
.env.*

# ── Uploads de usuários ───────────────────────────────────────
uploads/certificates/*
uploads/photos/*
uploads/asos/*
uploads/documents/*
!uploads/certificates/.gitkeep
!uploads/photos/.gitkeep
!uploads/asos/.gitkeep
!uploads/documents/.gitkeep
!uploads/asos/.htaccess
!uploads/documents/.htaccess

# ── Cache / logs ──────────────────────────────────────────────
*.log
*.cache

# ── Sistema operacional ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
